---
// Links use root-anchored hrefs (/#about) so the nav works from every page,
// including project detail pages, not just the homepage.
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#work', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="nav" id="nav">
  <a href="/" class="nav__brand">SS<span class="nav__dot">.</span></a>
  <nav class="nav__links">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <button class="nav__theme" id="themeToggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
    <svg class="nav__theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    <svg class="nav__theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
  <a href="/resources/AI_Engineer.pdf" target="_blank" rel="noopener" class="nav__cta">Resume</a>
  <button class="nav__burger" id="burger" aria-label="Menu"><span></span><span></span></button>
</header>
