---
// Portrait is a static asset in public/, referenced by absolute path.
---

<section class="hero" id="top">
  <div class="hero__grain"></div>
  <div class="hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow reveal">
        <span class="pulse"></span> Available for select AI engineering work
      </p>
      <h1 class="hero__title reveal">
        Sadeem<br />Sattar<span class="hero__accent">.</span>
      </h1>
      <p class="hero__lede reveal">
        Staff Engineer building <em>agentic AI systems</em> — product memory
        engines, a Venture Operating System, and LLM platforms that turn
        scattered signals into intelligence.
      </p>
      <div class="hero__meta reveal">
        <span>📍 Karachi, Pakistan</span>
        <span class="hero__divider">/</span>
        <span>DisruptLab</span>
        <span class="hero__divider">/</span>
        <span>AI · LLM · Agents</span>
      </div>
      <div class="hero__actions reveal">
        <a href="/#projects" class="btn btn--solid">
          View my work
          <svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
        <a href="/#contact" class="btn btn--ghost">Get in touch</a>
      </div>
    </div>
    <div class="hero__portrait reveal">
      <div class="portrait__frame">
        <img src="/resources/profile.png" alt="Sadeem Sattar" width="360" height="360" />
      </div>
      <div class="portrait__badge">
        <span class="portrait__badge-num">3+</span>
        <span class="portrait__badge-label">yrs shipping<br />AI in prod</span>
      </div>
    </div>
  </div>
  <a href="/#about" class="hero__scroll" aria-label="Scroll down">
    <span>Scroll</span>
    <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </a>
</section>
